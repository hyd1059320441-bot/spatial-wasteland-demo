#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
)

def Xform "Root"
{
    def Xform "Batch_000"
    {
        def Xform "GuardFrontRight"
        {
            def Material "DefaultMaterial" (
                customData = {
                    bool applyToneMapping = 1
                    string blendingMode = "OPAQUE"
                    string cullingMode = "BACK"
                    bool depthTest = 1
                    bool depthWrite = 1
                    string materialType = "SHADER_GRAPH"
                    float opacityThreshold = 0
                    string shaderGraphGuid = "3ce7b476-805d-4523-bc58-94c15261fd8a"
                }
            )
            {
                token outputs:mtlx:surface.connect = </Root/Batch_000/GuardFrontRight/DefaultMaterial/PreviewSurface.outputs:out>
                token outputs:spatial:vertex
                float2 ui:nodegraph:subgraphOutputs:pos = (377.25, 102.75)

                def Shader "PreviewSurface"
                {
                    uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
                    color3f inputs:diffuseColor = (0.82, 0.31, 0.095)
                    float inputs:diffuseOpacity = 1
                    float inputs:metallic = 0.08
                    float inputs:opacityThreshold = 0
                    float inputs:roughness = 0.84
                    token outputs:out
                    float2 ui:nodegraph:node:pos = (93.5, 102.75)
                    int ui:nodegraph:node:stackingOrder = 15
                }
            }
        }
    }
}

